# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=rag-backend-service
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# ── Database (PostgreSQL + pgvector) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ── Provider API keys (leave blank for Day 1 / health-only boot) ──────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# ── Models ────────────────────────────────────────────────────────────────────
GENERATION_MODEL=claude-opus-4-8
EMBEDDING_MODEL=voyage-3
RERANK_MODEL=rerank-3

# ── Retrieval tunables ────────────────────────────────────────────────────────
RETRIEVAL_TOP_N=40
RERANK_TOP_K=6
EMBEDDING_DIMENSIONS=1024

# ── AWS S3 (ingestion source) ─────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=
